      "source": [
        "from sklearn.metrics import average_precision_score, matthews_corrcoef, confusion_matrix, accuracy_score\n",
        "import numpy as np\n",
        "import seaborn as sns\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Predictions / probs\n",
        "y_proba_lr  = lr.predict_proba(X_test)[:, 1]\n",
        "y_pred_lr   = lr.predict(X_test)\n",
        "\n",
        "y_proba_rf  = rf.predict_proba(X_test)[:, 1]\n",
        "y_pred_rf   = rf.predict(X_test)\n",
        "\n",
        "y_proba_xgb = xgb_model.predict_proba(X_test)[:, 1]\n",
        "y_pred_xgb  = xgb_model.predict(X_test)\n",
        "\n",
        "# Scores\n",
        "results = []\n",
        "for name, y_proba, y_pred in [\n",
        "    (\"Logistic Regression\", y_proba_lr, y_pred_lr),\n",
        "    (\"Random Forest\",       y_proba_rf, y_pred_rf),\n",
        "    (\"XGBoost\",             y_proba_xgb, y_pred_xgb),\n",
        "]:\n",
        "    auprc = average_precision_score(y_test, y_proba)\n",
        "    mcc   = matthews_corrcoef(y_test, y_pred)\n",
        "    acc   = accuracy_score(y_test, y_pred)\n",
        "    results.append([name, auprc, mcc, acc])\n",
        "\n",
        "results_df = pd.DataFrame(results, columns=[\"Model\", \"AUPRC\", \"MCC\", \"Accuracy\"]).sort_values(\"AUPRC\", ascending=False)\n",
        "display(results_df)\n",
        "\n",
        "# Confusion matrices (all three side-by-side)\n",
        "cms = [\n",
        "    (\"Logistic Regression\", confusion_matrix(y_test, y_pred_lr)),\n",
        "    (\"Random Forest\",       confusion_matrix(y_test, y_pred_rf)),\n",
        "    (\"XGBoost\",             confusion_matrix(y_test, y_pred_xgb)),\n",
        "]\n",
        "\n",
        "fig, axs = plt.subplots(1, 3, figsize=(15, 4))\n",
        "for ax, (title, cm) in zip(axs, cms):\n",
        "    sns.heatmap(cm, annot=True, fmt=\"d\", cmap=\"Blues\", ax=ax, cbar=False)\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(\"Predicted\")\n",
        "    ax.set_ylabel(\"Actual\")\n",
        "plt.tight_layout()\n",
        "plt.savefig(\"confusion_matrices.png\", dpi=300)\n",
        "plt.show()\n",
        "\n",
        "# Save results table\n",
        "results_df.to_csv(\"results_table.csv\", index=False)\n",
        "print(\"Saved: results_table.csv, confusion_matrices.png\")\n"
