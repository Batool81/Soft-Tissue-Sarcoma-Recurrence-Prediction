        "# Helper: stacked bar function\n",
        "def stacked_rate_bar(df_in, cat_col, status_col=\"Status_text\", order=None, figsize=(7,4), title=None):\n",
        "    ctab = pd.crosstab(df_in[cat_col], df_in[status_col], normalize=\"index\") * 100\n",
        "    if order is not None:\n",
        "        ctab = ctab.loc[order]\n",
        "    ctab = ctab[[\"No recurrence\", \"Recurrence\"]]  # ensure consistent order\n",
        "    ctab.plot(kind=\"bar\", stacked=True, figsize=figsize)\n",
        "    plt.legend(title=\"Outcome\", bbox_to_anchor=(1.02, 1), loc=\"upper left\")\n",
        "    plt.ylabel(\"Percentage of patients\")\n",
        "    plt.xlabel(cat_col)\n",
        "    if title: plt.title(title)\n",
        "    plt.tight_layout()\n",
        "    plt.show()\n",
        "\n",
        "# Grade\n",
        "grade_order = plot_df[\"Grade\"].value_counts().index\n",
        "stacked_rate_bar(plot_df, \"Grade\", title=\"Outcome mix by Tumour Grade\", order=grade_order)\n",
        "\n",
        "# Treatment (rename if your exact column name differs, e.g., 'Treatment')\n",
        "if \"Treatment\" in plot_df.columns:\n",
        "    trt_order = plot_df[\"Treatment\"].value_counts().index\n",
        "    stacked_rate_bar(plot_df, \"Treatment\", title=\"Outcome mix by Treatment\", order=trt_order)\n"
