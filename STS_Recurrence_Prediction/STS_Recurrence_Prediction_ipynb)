        "# ================================\n",
        "# 5 Local SHAP cases (XGBoost)\n",
        "# ================================\n",
        "import numpy as np\n",
        "import shap\n",
        "import matplotlib.pyplot as plt\n",
        "from sklearn.metrics import confusion_matrix\n",
        "\n",
        "# 1) Identify TP, FN, TN, FP on the test set\n",
        "y_true = y_test.values\n",
        "y_pred = y_pred_xgb\n",
        "y_prob = y_proba_xgb\n",
        "\n",
        "# Masks\n",
        "TP_mask = (y_true == 1) & (y_pred == 1)\n",
        "FN_mask = (y_true == 1) & (y_pred == 0)\n",
        "TN_mask = (y_true == 0) & (y_pred == 0)\n",
        "FP_mask = (y_true == 0) & (y_pred == 1)\n",
        "\n",
        "# Helper: pick an index for each category.\n",
        "# If multiple candidates exist, pick the one with highest |0.5 - prob| for clarity.\n",
        "def pick_index(mask, prefer_high_prob_for_pos=True):\n",
        "    idxs = np.where(mask)[0]\n",
        "    if len(idxs) == 0:\n",
        "        return None\n",
        "    # pick the most \"confident\" example in that mask (furthest from 0.5)\n",
        "    conf = np.abs(y_prob[idxs] - 0.5)\n",
        "    return idxs[np.argmax(conf)]\n",
        "\n",
        "idx_tp = pick_index(TP_mask)\n",
        "idx_fn = pick_index(FN_mask)\n",
        "idx_tn = pick_index(TN_mask)\n",
        "idx_fp = pick_index(FP_mask)\n",
        "\n",
        "# Highest-risk overall (by predicted probability)\n",
        "idx_high = int(np.argmax(y_prob))\n",
        "\n",
        "print(\"Chosen indices (in X_test order):\",\n",
        "      {\"TP\": idx_tp, \"FN\": idx_fn, \"TN\": idx_tn, \"FP\": idx_fp, \"HIGH\": idx_high})\n",
        "\n",
        "# 2) Build a SHAP explainer for XGBoost (tree-based)\n",
        "explainer = shap.Explainer(xgb_model, X_train)  # uses TreeExplainer under the hood\n",
        "shap_test = explainer(X_test)                   # Explanation object aligned to X_test\n",
        "\n",
        "# 3) Optional helpers for nicer reporting\n",
        "def inverse_age(z):\n",
        "    # Only if 'Age' was z-scored and scaler is available\n",
        "    if \"Age\" in X_test.columns and 'scaler' in globals():\n",
        "        # Single-column scaler path used earlier\n",
        "        try:\n",
        "            # If only Age was scaled, scaler has .mean_ and .scale_\n",
        "            return float(z * scaler.scale_[0] + scaler.mean_[0])\n",
        "        except Exception:\n",
        "            return None\n",
        "    return None\n",
        "\n",
        "def decode_value(col, val):\n",
        "    # Turn label-encoded integers back to original categories where possible\n",
        "    try:\n",
        "        if col in label_encoders:\n",
        "            le = label_encoders[col]\n",
        "            return le.inverse_transform([int(val)])[0]\n",
        "    except Exception:\n",
        "        pass\n",
        "    return val\n",
        "\n",
        "def text_summary_for_index(idx, top_k=5):\n",
        "    # Grab the single-row Explanation\n",
        "    exp = shap.Explanation(\n",
        "        values       = shap_test.values[idx],\n",
        "        base_values  = shap_test.base_values[idx],\n",
        "        data         = X_test.iloc[idx].values,\n",
        "        feature_names= X_test.columns.tolist()\n",
        "    )\n",
        "    # Compute predicted prob from base + sum(values) (log-odds) if needed\n",
        "    # For tree models with shap.Explainer, exp.base_values is in log-odds; convert:\n",
        "    logit = exp.base_values + exp.values.sum()\n",
        "    pred_prob = 1 / (1 + np.exp(-logit))\n",
        "    # Rank features by absolute SHAP value\n",
        "    order = np.argsort(np.abs(exp.values))[::-1][:top_k]\n",
        "    lines = [f\"Predicted probability of recurrence: {pred_prob:.3f}\",\n",
        "             \"Top contributing features:\"]\n",
        "    for j in order:\n",
        "        feat = exp.feature_names[j]\n",
        "        raw_val = exp.data[j]\n",
        "        shown_val = decode_value(feat, raw_val)\n",
        "        direction = \"↑ increases risk\" if exp.values[j] > 0 else \"↓ decreases risk\"\n",
        "        if feat == \"Age\":\n",
        "            orig = inverse_age(raw_val)\n",
        "            if orig is not None:\n",
        "                shown_val = f\"{orig:.1f} years (z={raw_val:+.2f})\"\n",
        "        lines.append(f\"  • {feat}: {shown_val}  |  SHAP={exp.values[j]:+.3f}  ({direction})\")\n",
        "    return \"\\n\".join(lines), exp\n",
        "\n",
        "def plot_waterfall(exp, title, fname):\n",
        "    shap.plots.waterfall(exp, max_display=10, show=False)\n",
        "    plt.title(title)\n",
        "    plt.tight_layout()\n",
        "    plt.savefig(fname, dpi=300, bbox_inches=\"tight\")\n",
        "    plt.show()\n",
        "    print(f\"Saved: {fname}\")\n",
        "\n",
        "# 4) Generate plots + summaries for the five cases we picked\n",
        "cases = [\n",
        "    (\"True Positive (correct recurrence)\", idx_tp,  \"shap_xgb_TP.png\"),\n",
        "    (\"False Negative (missed recurrence)\", idx_fn,  \"shap_xgb_FN.png\"),\n",
        "    (\"True Negative (correct no recurrence)\", idx_tn, \"shap_xgb_TN.png\"),\n",
        "    (\"False Positive (false alarm)\", idx_fp,        \"shap_xgb_FP.png\"),\n",
        "    (\"Highest predicted risk (overall)\", idx_high,  \"shap_xgb_HIGH.png\"),\n",
        "]\n",
        "\n",
        "for title, idx, fname in cases:\n",
        "    if idx is None:\n",
        "        print(f\"Skipping {title}: no example available in this test split.\")\n",
        "        continue\n",
        "    summary, exp = text_summary_for_index(idx, top_k=6)\n",
        "    print(f\"\\n=== {title} (test index {idx}, dataset row {X_test.index[idx]}) ===\")\n",
        "    print(summary)\n",
        "    plot_waterfall(exp, f\"Local SHAP — XGBoost — {title}\", fname)\n"
