        "import pandas as pd\n",
        "from sklearn.preprocessing import LabelEncoder, StandardScaler\n",
        "\n",
        "# Load\n",
        "df = pd.read_csv(\"Soft Tissue Sarcoma Dataset.csv\")\n",
        "\n",
        "# ---- Harmonise schemas (handles either your raw or encoded file) ----\n",
        "# Drop obviously non-feature columns if present\n",
        "for col in [\"Patient ID\", \"MSKCC type\", \"index\"]:\n",
        "    if col in df.columns:\n",
        "        df = df.drop(columns=[col])\n",
        "\n",
        "# Build a binary Status column if the string label exists\n",
        "if \"Status (NED, AWD, D)\" in df.columns:\n",
        "    df[\"Status\"] = df[\"Status (NED, AWD, D)\"].apply(lambda x: 0 if str(x).strip().upper()==\"NED\" else 1)\n",
        "    df = df.drop(columns=[\"Status (NED, AWD, D)\"])\n",
        "\n",
        "# If Status already exists (0/1), keep as-is\n",
        "assert \"Status\" in df.columns, \"Couldn't find or derive a 'Status' column.\"\n",
        "\n",
        "# Encode object (categorical) columns\n",
        "label_encoders = {}\n",
        "cat_cols = df.select_dtypes(include=\"object\").columns.drop([\"Status\"], errors=\"ignore\")\n",
        "for col in cat_cols:\n",
        "    le = LabelEncoder()\n",
        "    df[col] = le.fit_transform(df[col].astype(str))\n",
        "    label_encoders[col] = le\n",
        "\n",
        "# Scale Age if present\n",
        "if \"Age\" in df.columns:\n",
        "    scaler = StandardScaler()\n",
        "    df[\"Age\"] = scaler.fit_transform(df[[\"Age\"]])\n",
        "\n",
        "print(\"✅ Preprocessing done\")\n",
        "print(\"Shape:\", df.shape)\n",
        "display(df.head())\n"
      ],
